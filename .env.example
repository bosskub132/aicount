# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# OCR (Google Vision is default; set OCR_PROVIDER=claude to use Claude instead)
GOOGLE_VISION_API_KEY=your-google-vision-api-key
OCR_PROVIDER=google_vision
ANTHROPIC_API_KEY=sk-ant-your-key

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# LINE Bot
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
LINE_DEFAULT_UPLOADED_BY=00000000-0000-0000-0000-000000000000

# Resend (Email)
RESEND_API_KEY=re_your-resend-key

# App
NEXT_PUBLIC_APP_URL=https://your-production-url.vercel.app

# Upstash Redis (rate limiting — optional, falls back to in-process for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Migration
MONGODB_URI=mongodb://localhost:27017/expense-bill-scanner
LEGACY_EXPORT_DIR=./legacy-export
